STORAGE_ROOT=./storage
PUBLIC_BASE_URL=http://127.0.0.1:8001
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
GENERATION_STUB=true
JOB_SIMULATION_SECONDS=5
LOG_LEVEL=INFO
APP_VERSION=0.1.0
APP_NAME=fitcheck-api
# Get token from replicate.com
REPLICATE_API_TOKEN=your_token_here

# GENERATION_MODE=replicate_2d for CPU/Replicate
# GENERATION_MODE=econ_3d requires NVIDIA GPU with 16GB+ VRAM
GENERATION_MODE=replicate_2d
