# ─────────────────────────────────────────────────────────────────────────
# FitCheck AI — backend configuration
# Copy to .env and fill in.  .env is gitignored (never commit real secrets).
# ─────────────────────────────────────────────────────────────────────────

# ── Core server ──
STORAGE_ROOT=./storage
PUBLIC_BASE_URL=http://127.0.0.1:8001
MAX_UPLOAD_BYTES=10485760
# Comma-separated. Must include the Vite dev origin (default :8080).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO
APP_VERSION=0.1.0
APP_NAME=fitcheck-api

# ─────────────────────────────────────────────────────────────────────────
# 3D AVATAR GENERATION  (photo → 3D avatar)
# ─────────────────────────────────────────────────────────────────────────
# AVATAR_MODE selects the pipeline behind POST /api/v1/avatar/create:
#
#   local_pifuhd  Real photo→3D on THIS machine via pifuhd_server.py (port 8090).
#                 Needs an NVIDIA GPU (8GB+; 16GB+ for best quality) + the
#                 one-time setup in LOCAL_GPU_SETUP.md. This is the full feature.
#   runpod        Offload reconstruction to a RunPod serverless GPU endpoint
#                 (see ../runpod-worker/README.md). No local GPU required.
#   stub          No GPU, no ML — downloads a placeholder .glb so the whole
#                 upload → job → 3D viewer UI works for development/demos.
AVATAR_MODE=local_pifuhd

# Where the local PIFuHD server listens (used only when AVATAR_MODE=local_pifuhd)
LOCAL_INFERENCE_URL=http://127.0.0.1:8090

# ── PIFuHD quality knobs (read by pifuhd_server.py) ──
# Marching-cubes grid resolution: higher = crisper face/body, more VRAM + time.
# Leave UNSET to auto-pick from your GPU's VRAM (>=16GB→512, >=8GB→384, else 256).
# Override for a fixed value; the server auto-falls back to a coarser grid on OOM.
#   PIFUHD_RESOLUTION=512
# Final mesh face budget after decimation. Higher = sharper detail, larger .glb
# (slower browser load). 80000 is a good balance; heavy GPUs can push 120000.
#   AVATAR_TARGET_FACES=80000

# ── RunPod (only when AVATAR_MODE=runpod) ──
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# ─────────────────────────────────────────────────────────────────────────
# 2D TRY-ON  (dress a photo — also the first stage of "try clothes on avatar")
# ─────────────────────────────────────────────────────────────────────────
# replicate_2d  Dress the photo via the hosted IDM-VTON pipeline (no local GPU).
# econ_3d       Reserved for a local ECON+TeCH GPU pipeline (NVIDIA 16GB+).
GENERATION_MODE=replicate_2d
GENERATION_STUB=false
JOB_SIMULATION_SECONDS=5

# Optional HuggingFace token — raises IDM-VTON Space rate limits. huggingface.co/settings/tokens
HF_TOKEN=
# Optional — only if you wire up the Replicate 2D backend. replicate.com/account
REPLICATE_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# AI STYLIST  (optional chat + product search features)
# ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
SERPAPI_KEY=
SHOPPING_LOCALE=in
SHOPPING_CURRENCY=₹
